# Supabase project dedicated to AgriNex only
SUPABASE_URL=https://YOUR-AGRINEX-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy anon key is also accepted if you use that instead:
# SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 10-digit Indian mobile numbers are normalized to +91 by default.
PHONE_COUNTRY_CODE=+91

# Only needed for local development on a different frontend port.
AGRI_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
